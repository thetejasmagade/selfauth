{
  "specVersion": "0.1",
  "adapter": {
    "backend": "gin",
    "frontend": "none",
    "database": "postgresql",
    "orm": "none"
  },
  "authentication": {
    "methods": [
      "password"
    ],
    "emailVerification": {
      "mode": "required",
      "tokenTtlMinutes": 1440
    },
    "registration": {
      "revealExistingEmail": false,
      "signInAfterRegistration": false
    },
    "passwordReset": {
      "tokenTtlMinutes": 30
    },
    "password": {
      "minLength": 8,
      "maxLength": 128,
      "rejectCommon": true,
      "hashing": {
        "memoryKiB": 19456,
        "iterations": 2,
        "parallelism": 1
      }
    },
    "sessions": {
      "strategy": "database",
      "idleTimeoutMinutes": 10080,
      "absoluteTimeoutMinutes": 43200,
      "touchIntervalSeconds": 60,
      "cookie": {
        "name": "__Host-session",
        "sameSite": "lax",
        "secure": true
      }
    },
    "rateLimit": {
      "login": {
        "perAccount": {
          "limit": 5,
          "windowSeconds": 900
        },
        "perAddress": {
          "limit": 100,
          "windowSeconds": 900
        }
      },
      "passwordChange": {
        "perAccount": {
          "limit": 5,
          "windowSeconds": 900
        },
        "perAddress": {
          "limit": 100,
          "windowSeconds": 900
        }
      },
      "register": {
        "perAccount": {
          "limit": 3,
          "windowSeconds": 900
        },
        "perAddress": {
          "limit": 20,
          "windowSeconds": 900
        }
      },
      "passwordResetRequest": {
        "perAccount": {
          "limit": 3,
          "windowSeconds": 900
        },
        "perAddress": {
          "limit": 20,
          "windowSeconds": 900
        }
      },
      "verificationResend": {
        "perAccount": {
          "limit": 3,
          "windowSeconds": 900
        },
        "perAddress": {
          "limit": 20,
          "windowSeconds": 900
        }
      }
    }
  },
  "authorization": {
    "strategy": "rbac",
    "permissions": [],
    "roles": {
      "user": [],
      "admin": []
    },
    "defaultRoles": [
      "user"
    ],
    "reauthenticationWindowMinutes": 15
  },
  "http": {
    "bodyLimitBytes": 16384,
    "basePath": "/auth",
    "trustedOrigins": [],
    "trustProxy": false,
    "csrf": {
      "mode": "header",
      "headerName": "X-SelfAuth-CSRF"
    }
  }
}
