// SelfAuth data model for PostgreSQL (packages/spec/specs/DATA_MODEL.md).
// Application-owned: edit freely, then create a migration with
// `pnpm db:migrate:create`. SelfAuth-owned tables are listed in
// selfauth.manifest.json; tables you add are never touched by SelfAuth.

generator client {
  provider            = "prisma-client"
  output              = "../src/selfauth/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum AccountState {
  pending
  active
  suspended
  disabled
  deleted

  @@map("auth_account_state")
}

enum CredentialType {
  password

  @@map("auth_credential_type")
}

enum SessionRevokedReason {
  logout
  logout_all
  password_changed
  password_reset
  state_changed
  admin
  rotated

  @@map("auth_session_revoked_reason")
}

enum EventOutcome {
  success
  failure

  @@map("auth_event_outcome")
}

model AuthUser {
  id              String       @id @db.Uuid
  email           String?      @db.VarChar(254)
  /// Unique among non-deleted users: cleared on deletion (IDENT-EMAIL-003, IDENT-DELETE-002).
  emailNormalized String?      @unique @map("email_normalized") @db.VarChar(254)
  emailVerifiedAt DateTime?    @map("email_verified_at") @db.Timestamptz(3)
  state           AccountState
  createdAt       DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)

  credentials AuthCredential[]
  sessions    AuthSession[]
  roles       AuthUserRole[]
  resetTokens AuthPasswordResetToken[]
  verifyTokens AuthEmailVerificationToken[]

  @@map("auth_users")
}

/// Kept apart from the user record (IDENT-PROFILE-001).
model AuthCredential {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  type       CredentialType
  /// Argon2id PHC string; never exposed (IDENT-PROFILE-002).
  secretHash String         @map("secret_hash")
  createdAt  DateTime       @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @map("updated_at") @db.Timestamptz(3)

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("auth_credentials")
}

model AuthSession {
  id                String                @id @db.Uuid
  /// SHA-256 of the session token; the token itself is never stored (AUTHN-SESS-002).
  tokenHash         String                @unique @map("token_hash") @db.Char(64)
  userId            String                @map("user_id") @db.Uuid
  createdAt         DateTime              @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime              @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime              @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime              @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(3)
  revokedReason     SessionRevokedReason? @map("revoked_reason")
  ipAddress         String?               @map("ip_address") @db.VarChar(64)
  userAgent         String?               @map("user_agent") @db.VarChar(512)
  reauthenticatedAt DateTime?             @map("reauthenticated_at") @db.Timestamptz(3)

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([absoluteExpiresAt])
  @@map("auth_sessions")
}

model AuthRole {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String  @unique @db.VarChar(64)
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  users       AuthUserRole[]
  permissions AuthRolePermission[]

  @@map("auth_roles")
}

model AuthPermission {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String  @unique @db.VarChar(128)
  description String?

  roles AuthRolePermission[]

  @@map("auth_permissions")
}

model AuthUserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @map("assigned_at") @db.Timestamptz(3)
  assignedBy String?  @map("assigned_by") @db.Uuid

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AuthRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("auth_user_roles")
}

model AuthRolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       AuthRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AuthPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("auth_role_permissions")
}

model AuthPasswordResetToken {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_password_reset_tokens")
}

model AuthEmailVerificationToken {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  /// Normalized address the token was issued for (AUTHN-VERIFY-005).
  email         String    @db.VarChar(254)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_email_verification_tokens")
}

/// Append-only audit log (SEC-AUDIT-004). No foreign keys: events outlive users.
model AuthSecurityEvent {
  id         String       @id @db.Uuid
  /// Insertion order; timestamps alone can tie.
  seq        BigInt       @unique @default(autoincrement())
  type       String       @db.VarChar(64)
  outcome    EventOutcome
  occurredAt DateTime     @map("occurred_at") @db.Timestamptz(3)
  userId     String?      @map("user_id") @db.Uuid
  actorId    String?      @map("actor_id") @db.Uuid
  ipAddress  String?      @map("ip_address") @db.VarChar(64)
  userAgent  String?      @map("user_agent") @db.VarChar(512)
  requestId  String?      @map("request_id") @db.VarChar(64)
  metadata   Json         @default("{}")

  @@index([occurredAt])
  @@index([userId])
  @@map("auth_security_events")
}

/// Shared rate-limit state for multi-instance deployments (SEC-RATE-006).
model AuthRateLimit {
  key          String   @id @db.VarChar(320)
  count        Int
  windowEndsAt DateTime @map("window_ends_at") @db.Timestamptz(3)
  blockedUntil DateTime @map("blocked_until") @db.Timestamptz(3)
  strikes      Int
  lastBlockAt  DateTime @map("last_block_at") @db.Timestamptz(3)

  @@index([windowEndsAt])
  @@map("auth_rate_limits")
}
