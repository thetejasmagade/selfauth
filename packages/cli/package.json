{
  "name": "@selfauth/cli",
  "version": "0.18.0",
  "description": "SelfAuth CLI: generate project-local authentication you own, and manage its migrations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thetejasmagade/selfauth.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/thetejasmagade/selfauth/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/thetejasmagade/selfauth/issues"
  },
  "keywords": [
    "selfauth",
    "authentication",
    "authorization",
    "express",
    "prisma",
    "generator",
    "cli"
  ],
  "type": "module",
  "bin": {
    "selfauth": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./bin": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-templates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@selfauth/migration": "workspace:*",
    "@selfauth/spec": "workspace:*",
    "commander": "^15.1.0",
    "diff": "^9.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
