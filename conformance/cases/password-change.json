{
  "cases": [
    {
      "id": "CT-PWCHG-001",
      "title": "Password change revokes other sessions and outstanding reset tokens",
      "category": "password-change",
      "level": "core",
      "requirements": ["AUTHN-PWCHG-003", "AUTHN-PWCHG-004", "AUTHN-PWCHG-006", "AUTHN-SESS-006"],
      "given": [
        {
          "user": "alice",
          "email": "alice@example.test",
          "password": "correct horse battery staple",
          "state": "active"
        }
      ],
      "steps": [
        {
          "op": "login",
          "as": "laptop",
          "input": {
            "email": "alice@example.test",
            "password": "correct horse battery staple"
          }
        },
        {
          "op": "login",
          "as": "phone",
          "input": {
            "email": "alice@example.test",
            "password": "correct horse battery staple"
          }
        },
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "alice@example.test"
          }
        },
        {
          "op": "readLastEmail",
          "input": {
            "to": "alice@example.test"
          },
          "save": "reset"
        },
        {
          "op": "changePassword",
          "as": "laptop",
          "input": {
            "currentPassword": "correct horse battery staple",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "success"
          }
        },
        {
          "op": "getCurrentUser",
          "as": "laptop",
          "note": "current session kept or rotated (cookie follows)",
          "expect": {
            "outcome": "success"
          }
        },
        {
          "op": "getCurrentUser",
          "as": "phone",
          "expect": {
            "outcome": "error",
            "code": "UNAUTHENTICATED"
          }
        },
        {
          "op": "resetPassword",
          "input": {
            "token": "$reset.token",
            "newPassword": "yet another passphrase"
          },
          "expect": {
            "outcome": "error",
            "code": "TOKEN_INVALID"
          }
        },
        {
          "op": "login",
          "input": {
            "email": "alice@example.test",
            "password": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "success"
          }
        },
        {
          "op": "inspectEvents",
          "input": {
            "type": "password.changed"
          },
          "expect": {
            "outcome": "success",
            "assert": {
              "count": 1
            }
          }
        }
      ]
    },
    {
      "id": "CT-PWCHG-002",
      "title": "Password change requires a session and the current password, and is rate limited",
      "category": "password-change",
      "level": "core",
      "requirements": ["AUTHN-PWCHG-001", "SEC-RATE-001"],
      "given": [
        {
          "user": "alice",
          "email": "alice@example.test",
          "password": "correct horse battery staple",
          "state": "active"
        }
      ],
      "steps": [
        {
          "op": "changePassword",
          "as": "stranger",
          "input": {
            "currentPassword": "correct horse battery staple",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "error",
            "code": "UNAUTHENTICATED"
          }
        },
        {
          "op": "login",
          "input": {
            "email": "alice@example.test",
            "password": "correct horse battery staple"
          }
        },
        {
          "op": "changePassword",
          "input": {
            "currentPassword": "wrong password!!",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "changePassword",
          "input": {
            "currentPassword": "wrong password!!",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "changePassword",
          "input": {
            "currentPassword": "wrong password!!",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "changePassword",
          "input": {
            "currentPassword": "wrong password!!",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "changePassword",
          "input": {
            "currentPassword": "wrong password!!",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "changePassword",
          "input": {
            "currentPassword": "wrong password!!",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "error",
            "code": "RATE_LIMITED"
          }
        }
      ]
    },
    {
      "id": "CT-PWCHG-003",
      "title": "The new password must satisfy the policy",
      "category": "password-change",
      "level": "core",
      "requirements": ["AUTHN-PWCHG-002", "SEC-PWPOLICY-002"],
      "given": [
        {
          "user": "alice",
          "email": "alice@example.test",
          "password": "correct horse battery staple",
          "state": "active"
        }
      ],
      "steps": [
        {
          "op": "login",
          "input": {
            "email": "alice@example.test",
            "password": "correct horse battery staple"
          }
        },
        {
          "op": "changePassword",
          "input": {
            "currentPassword": "correct horse battery staple",
            "newPassword": "short"
          },
          "expect": {
            "outcome": "error",
            "code": "PASSWORD_POLICY_VIOLATION"
          }
        },
        {
          "op": "changePassword",
          "input": {
            "currentPassword": "correct horse battery staple",
            "newPassword": "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
          },
          "expect": {
            "outcome": "error",
            "code": "PASSWORD_POLICY_VIOLATION"
          }
        },
        {
          "op": "login",
          "as": "other",
          "note": "old password unchanged",
          "input": {
            "email": "alice@example.test",
            "password": "correct horse battery staple"
          },
          "expect": {
            "outcome": "success"
          }
        }
      ]
    },
    {
      "id": "CT-PWCHG-004",
      "title": "Concurrent current-password guesses cannot exceed the password-change limit",
      "category": "password-change",
      "level": "core",
      "requirements": ["AUTHN-PWCHG-001", "SEC-RATE-001"],
      "config": {
        "authentication": {
          "rateLimit": {
            "passwordChange": {
              "perAccount": {
                "limit": 3
              },
              "perAddress": {
                "limit": 100
              }
            }
          }
        }
      },
      "given": [
        {
          "user": "alice",
          "email": "alice@example.test",
          "password": "correct horse battery staple",
          "state": "active"
        }
      ],
      "steps": [
        {
          "op": "login",
          "input": {
            "email": "alice@example.test",
            "password": "correct horse battery staple"
          }
        },
        {
          "op": "concurrent",
          "note": "ten wrong current passwords at once on one session",
          "input": {
            "steps": [
              {
                "op": "changePassword",
                "input": {
                  "currentPassword": "wrong password!!",
                  "newPassword": "a brand new passphrase 42"
