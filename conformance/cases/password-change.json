                "input": {
                  "currentPassword": "wrong password!!",
                  "newPassword": "a brand new passphrase 42"
                }
              },
              {
                "op": "changePassword",
                "input": {
                  "currentPassword": "wrong password!!",
                  "newPassword": "a brand new passphrase 42"
                }
              },
              {
                "op": "changePassword",
                "input": {
                  "currentPassword": "wrong password!!",
                  "newPassword": "a brand new passphrase 42"
                }
              },
              {
                "op": "changePassword",
                "input": {
                  "currentPassword": "wrong password!!",
                  "newPassword": "a brand new passphrase 42"
