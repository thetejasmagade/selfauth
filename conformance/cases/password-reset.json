{
  "cases": [
    {
      "id": "CT-RESET-001",
      "title": "Reset requests are indistinguishable for known and unknown emails",
      "category": "password-reset",
      "level": "core",
      "requirements": ["AUTHN-RESET-001", "SEC-ENUM-001"],
      "given": [
        {
          "user": "alice",
          "email": "alice@example.test",
          "password": "correct horse battery staple",
          "state": "active"
        }
      ],
      "steps": [
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "alice@example.test"
          },
          "expect": {
            "outcome": "success"
          },
          "save": "known"
        },
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "nobody@example.test"
          },
          "expect": {
            "outcome": "success",
            "indistinguishableFrom": "known"
          }
        },
        {
          "op": "readLastEmail",
          "input": {
            "to": "alice@example.test"
          },
          "expect": {
            "outcome": "success",
            "assert": {
              "kind": "passwordReset"
            }
          }
        },
        {
          "op": "readLastEmail",
          "input": {
            "to": "nobody@example.test"
          },
          "expect": {
            "outcome": "success",
            "assert": {
              "none": true
            }
          }
        }
      ]
    },
    {
      "id": "CT-RESET-002",
      "title": "No reset token is issued for suspended, disabled or deleted accounts",
      "category": "password-reset",
      "level": "core",
      "requirements": ["AUTHN-RESET-002"],
      "given": [
        {
          "user": "susp",
          "email": "susp@example.test",
          "password": "correct horse battery staple",
          "state": "suspended"
        },
        {
          "user": "dis",
          "email": "dis@example.test",
          "password": "correct horse battery staple",
          "state": "disabled"
        },
        {
          "user": "gone",
          "email": "gone@example.test",
          "password": "correct horse battery staple",
          "state": "deleted"
        }
      ],
      "steps": [
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "susp@example.test"
          },
          "expect": {
            "outcome": "success"
          }
        },
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "dis@example.test"
          },
          "expect": {
            "outcome": "success"
          }
        },
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "gone@example.test"
          },
          "expect": {
            "outcome": "success"
          }
        },
        {
          "op": "inspectStorage",
          "input": {
            "entity": "passwordResetToken"
          },
          "expect": {
            "outcome": "success",
            "assert": {
              "count": 0
            }
          }
        }
      ]
    },
    {
      "id": "CT-RESET-003",
      "title": "A successful reset changes the password and revokes every session",
      "category": "password-reset",
      "level": "core",
      "requirements": [
        "AUTHN-RESET-003",
        "AUTHN-RESET-010",
        "AUTHN-RESET-013",
        "SEC-TOKEN-002",
        "AUTHN-SESS-006"
      ],
      "given": [
        {
          "user": "alice",
          "email": "alice@example.test",
          "password": "correct horse battery staple",
          "state": "active"
        }
      ],
      "steps": [
        {
          "op": "login",
          "as": "laptop",
          "input": {
            "email": "alice@example.test",
            "password": "correct horse battery staple"
          }
        },
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "alice@example.test"
          }
        },
        {
          "op": "readLastEmail",
          "input": {
            "to": "alice@example.test"
          },
          "save": "mail"
        },
        {
          "op": "inspectStorage",
          "input": {
            "entity": "passwordResetToken"
          },
          "expect": {
            "outcome": "success",
            "assert": {
              "noFieldContaining": ["$mail.token"],
              "first.tokenHash": {
                "sha256Of": "$mail.token"
              }
            }
          }
        },
        {
          "op": "resetPassword",
          "input": {
            "token": "$mail.token",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "success",
            "sessionCreated": false
          }
        },
        {
          "op": "getCurrentUser",
          "as": "laptop",
          "expect": {
            "outcome": "error",
            "code": "UNAUTHENTICATED"
          }
        },
        {
          "op": "login",
          "input": {
            "email": "alice@example.test",
            "password": "correct horse battery staple"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "login",
          "input": {
            "email": "alice@example.test",
            "password": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "success"
          }
        },
        {
          "op": "inspectEvents",
          "input": {
            "type": "password.reset.requested"
          },
          "expect": {
            "outcome": "success",
            "assert": {
              "count": 1
            }
          }
        },
        {
          "op": "inspectEvents",
          "input": {
            "type": "password.reset.completed"
          },
          "expect": {
            "outcome": "success",
            "assert": {
              "count": 1
            }
          }
        }
      ]
    },
    {
      "id": "CT-RESET-004",
      "title": "Reset tokens expire after the configured TTL",
      "category": "password-reset",
      "level": "core",
      "requirements": ["AUTHN-RESET-003", "AUTHN-RESET-007"],
      "given": [
        {
          "user": "alice",
          "email": "alice@example.test",
          "password": "correct horse battery staple",
          "state": "active"
        }
      ],
      "steps": [
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "alice@example.test"
          }
        },
        {
          "op": "readLastEmail",
          "input": {
            "to": "alice@example.test"
          },
          "save": "mail"
        },
        {
          "op": "advanceClock",
          "input": {
            "minutes": 31
          }
        },
        {
          "op": "resetPassword",
          "input": {
            "token": "$mail.token",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "error",
            "code": "TOKEN_INVALID"
          }
        }
      ]
    },
    {
      "id": "CT-RESET-005",
      "title": "Requesting a new reset invalidates earlier tokens",
      "category": "password-reset",
      "level": "core",
      "requirements": ["AUTHN-RESET-004"],
      "given": [
        {
          "user": "alice",
          "email": "alice@example.test",
          "password": "correct horse battery staple",
          "state": "active"
        }
      ],
      "steps": [
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "alice@example.test"
          }
        },
        {
          "op": "readLastEmail",
          "input": {
            "to": "alice@example.test"
          },
          "save": "first"
        },
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "alice@example.test"
          }
        },
        {
          "op": "readLastEmail",
          "input": {
            "to": "alice@example.test"
          },
          "save": "second"
        },
        {
          "op": "resetPassword",
          "input": {
            "token": "$first.token",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "error",
            "code": "TOKEN_INVALID"
          }
        },
        {
          "op": "resetPassword",
          "input": {
            "token": "$second.token",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "success"
          }
        }
      ]
    },
    {
      "id": "CT-RESET-006",
      "title": "A password-policy violation does not consume the token",
      "category": "password-reset",
      "level": "core",
      "requirements": ["AUTHN-RESET-008"],
      "given": [
        {
          "user": "alice",
          "email": "alice@example.test",
          "password": "correct horse battery staple",
          "state": "active"
        }
      ],
      "steps": [
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "alice@example.test"
          }
        },
        {
          "op": "readLastEmail",
          "input": {
            "to": "alice@example.test"
          },
          "save": "mail"
        },
        {
          "op": "resetPassword",
          "input": {
            "token": "$mail.token",
            "newPassword": "short"
          },
          "expect": {
            "outcome": "error",
            "code": "PASSWORD_POLICY_VIOLATION"
          }
        },
        {
          "op": "resetPassword",
          "input": {
            "token": "$mail.token",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "success"
          }
        }
      ]
    },
    {
      "id": "CT-RESET-007",
      "title": "Reset tokens are single-use, including under concurrency",
      "category": "password-reset",
      "level": "core",
      "requirements": ["AUTHN-RESET-009", "DATA-MODEL-002", "SEC-TOKEN-003"],
      "given": [
        {
          "user": "alice",
          "email": "alice@example.test",
          "password": "correct horse battery staple",
          "state": "active"
        }
      ],
      "steps": [
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "alice@example.test"
          }
        },
        {
          "op": "readLastEmail",
          "input": {
            "to": "alice@example.test"
          },
          "save": "mail"
        },
        {
          "op": "concurrent",
          "input": {
            "steps": [
              {
                "op": "resetPassword",
                "as": "c0",
                "input": {
                  "token": "$mail.token",
                  "newPassword": "concurrent passphrase 0"
                }
              },
              {
                "op": "resetPassword",
                "as": "c1",
                "input": {
                  "token": "$mail.token",
                  "newPassword": "concurrent passphrase 1"
                }
              },
              {
                "op": "resetPassword",
                "as": "c2",
                "input": {
                  "token": "$mail.token",
                  "newPassword": "concurrent passphrase 2"
                }
              },
              {
                "op": "resetPassword",
                "as": "c3",
                "input": {
                  "token": "$mail.token",
                  "newPassword": "concurrent passphrase 3"
                }
              },
              {
                "op": "resetPassword",
                "as": "c4",
                "input": {
                  "token": "$mail.token",
                  "newPassword": "concurrent passphrase 4"
                }
              }
            ]
          },
          "expect": {
            "outcome": "success",
            "successCount": 1
          }
        },
        {
          "op": "resetPassword",
          "input": {
            "token": "$mail.token",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "error",
            "code": "TOKEN_INVALID"
          }
        }
      ]
    },
    {
      "id": "CT-RESET-008",
      "title": "A token becomes invalid when its account is suspended",
      "category": "password-reset",
      "level": "authorization",
      "requirements": ["AUTHN-RESET-007", "IDENT-STATE-003"],
      "given": [
        {
          "user": "alice",
          "email": "alice@example.test",
          "password": "correct horse battery staple",
          "state": "active"
        },
        {
          "user": "admin",
          "email": "admin@example.test",
          "password": "correct horse battery staple",
          "state": "active",
          "roles": ["admin"]
        }
      ],
      "steps": [
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "alice@example.test"
          }
        },
        {
          "op": "readLastEmail",
          "input": {
            "to": "alice@example.test"
          },
          "save": "mail"
        },
        {
          "op": "login",
          "as": "admin",
          "input": {
            "email": "admin@example.test",
            "password": "correct horse battery staple"
          }
        },
        {
          "op": "setAccountState",
          "as": "admin",
          "input": {
            "user": "$alice.id",
            "state": "suspended"
          },
          "expect": {
            "outcome": "success"
          }
        },
        {
          "op": "resetPassword",
          "input": {
            "token": "$mail.token",
            "newPassword": "a brand new passphrase 42"
          },
          "expect": {
            "outcome": "error",
            "code": "TOKEN_INVALID"
          }
        }
      ]
    },
    {
      "id": "CT-RESET-009",
      "title": "Reset requests are rate limited, identically for unknown emails",
      "category": "password-reset",
      "level": "core",
      "requirements": ["AUTHN-RESET-005", "SEC-RATE-002", "SEC-RATE-004"],
      "given": [
        {
          "user": "alice",
          "email": "alice@example.test",
          "password": "correct horse battery staple",
          "state": "active"
        }
      ],
      "steps": [
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "alice@example.test"
          },
          "expect": {
            "outcome": "success"
          }
        },
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "alice@example.test"
          },
          "expect": {
            "outcome": "success"
          }
        },
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "alice@example.test"
          },
          "expect": {
            "outcome": "success"
          }
        },
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "alice@example.test"
          },
          "expect": {
            "outcome": "error",
            "code": "RATE_LIMITED"
          },
          "save": "limited"
        },
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "nobody@example.test"
          },
          "expect": {
            "outcome": "success"
          }
        },
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "nobody@example.test"
          },
          "expect": {
            "outcome": "success"
          }
        },
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "nobody@example.test"
          },
          "expect": {
            "outcome": "success"
          }
        },
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "nobody@example.test"
          },
          "expect": {
            "outcome": "error",
            "code": "RATE_LIMITED",
            "indistinguishableFrom": "limited"
          }
        }
      ]
    },
    {
      "id": "CT-RESET-010",
      "title": "The 'requested' event is recorded only when a token is issued",
      "category": "password-reset",
      "level": "core",
      "requirements": ["AUTHN-RESET-013"],
      "given": [],
      "steps": [
        {
          "op": "requestPasswordReset",
          "input": {
            "email": "nobody@example.test"
          }
        },
        {
          "op": "inspectEvents",
          "input": {
            "type": "password.reset.requested"
          },
          "expect": {
            "outcome": "success",
            "assert": {
              "count": 0
            }
          }
        }
      ]
    }
  ]
}
