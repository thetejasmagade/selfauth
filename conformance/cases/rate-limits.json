{
  "cases": [
    {
      "id": "CT-RATE-001",
      "title": "Login is limited per account, even for unknown accounts and correct passwords",
      "category": "rate-limits",
      "level": "core",
      "requirements": ["SEC-RATE-001", "SEC-RATE-004", "AUTHN-LOGIN-006", "SEC-AUDIT-001"],
      "given": [
        {
          "user": "alice",
          "email": "alice@example.test",
          "password": "correct horse battery staple",
          "state": "active"
        }
      ],
      "steps": [
        {
          "op": "login",
          "input": {
            "email": "alice@example.test",
            "password": "wrong password!!"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "login",
          "input": {
            "email": "alice@example.test",
            "password": "wrong password!!"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "login",
          "input": {
            "email": "alice@example.test",
            "password": "wrong password!!"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "login",
          "input": {
            "email": "alice@example.test",
            "password": "wrong password!!"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "login",
          "input": {
            "email": "alice@example.test",
            "password": "wrong password!!"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "login",
          "note": "correct password, still limited",
          "input": {
            "email": "alice@example.test",
            "password": "correct horse battery staple"
          },
          "expect": {
            "outcome": "error",
            "code": "RATE_LIMITED",
            "sessionCreated": false
          },
          "save": "limited"
        },
        {
          "op": "login",
          "input": {
            "email": "nobody@example.test",
            "password": "wrong password!!"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "login",
          "input": {
            "email": "nobody@example.test",
            "password": "wrong password!!"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "login",
          "input": {
            "email": "nobody@example.test",
            "password": "wrong password!!"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "login",
          "input": {
            "email": "nobody@example.test",
            "password": "wrong password!!"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "login",
          "input": {
            "email": "nobody@example.test",
            "password": "wrong password!!"
          },
          "expect": {
            "outcome": "error",
            "code": "INVALID_CREDENTIALS"
          }
        },
        {
          "op": "login",
          "input": {
            "email": "nobody@example.test",
            "password": "wrong password!!"
          },
          "expect": {
            "outcome": "error",
            "code": "RATE_LIMITED",
            "indistinguishableFrom": "limited"
          }
        },
        {
          "op": "inspectEvents",
          "input": {
            "type": "rate_limit.triggered"
          },
          "expect": {
            "outcome": "success",
            "assert": {
              "countAtLeast": 1
            }
          }
        }
      ]
    },
