{
  "name": "@selfauth/conformance",
  "version": "0.5.0",
  "description": "Language-neutral SelfAuth conformance cases and requirement-coverage tooling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thetejasmagade/selfauth.git",
    "directory": "conformance"
  },
  "homepage": "https://github.com/thetejasmagade/selfauth/tree/main/conformance#readme",
  "bugs": {
    "url": "https://github.com/thetejasmagade/selfauth/issues"
  },
  "keywords": [
    "selfauth",
    "authentication",
    "conformance",
    "testing"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cases/*": "./cases/*",
    "./verification.json": "./verification.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "selfauth-coverage": "./dist/report.js"
  },
  "files": [
    "dist",
    "cases",
    "verification.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage:report": "node dist/report.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@selfauth/spec": "workspace:*",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
