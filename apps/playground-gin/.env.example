# Copy to .env (or export these) for local development. Never commit .env.
# Placeholders only (SEC-SECRET-002). The server reads the process environment;
# load a file with your shell or a tool such as direnv.
APP_ENV=development
PORT=3000
SELFAUTH_APP_BASE_URL=http://localhost:5173
# Required when http.csrf.mode is "token": 32+ random bytes, base64url.
# SELFAUTH_CSRF_SECRET=
