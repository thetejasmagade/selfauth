{
  "name": "@selfauth/playground-next-web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js reference frontend for SelfAuth: application-owned auth client, hooks, route guards and pages. It talks to any SelfAuth backend through Next.js rewrites.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 5175",
    "build": "next build",
    "start": "next start --port 5175",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@selfauth/spec": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "vite": "^8.3.8"
  }
}
