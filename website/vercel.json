{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vitepress",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm docs:build",
  "outputDirectory": ".vitepress/dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/guide/what-is-selfauth",
      "destination": "/start/what-is-selfauth",
      "permanent": true
    },
    {
      "source": "/guide/how-it-works",
      "destination": "/start/how-it-works",
      "permanent": true
    },
    {
      "source": "/guide/concepts",
      "destination": "/start/how-it-works",
      "permanent": true
    },
    {
      "source": "/getting-started/prerequisites",
      "destination": "/start/pick-your-stack",
      "permanent": true
    },
