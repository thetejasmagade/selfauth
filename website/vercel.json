      "destination": "/start/pick-your-stack",
      "permanent": true
    },
    {
      "source": "/getting-started/quick-start",
      "destination": "/express/create-project",
      "permanent": true
    },
    {
      "source": "/getting-started/first-flow",
      "destination": "/express/run-and-sign-in",
      "permanent": true
    },
    {
