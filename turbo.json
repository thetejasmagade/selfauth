{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": [],
      "env": ["TEST_DATABASE_URL", "SELFAUTH_REQUIRE_POSTGRES"]
    },
    "lint": {
      "outputs": []
    },
    "generate": {
      "outputs": ["src/generated/**"],
      "inputs": ["prisma/**", "prisma.config.ts"]
    }
  }
}
